/* ============================================
 * 课程表视图样式（课程表页与考勤页共用）
 * 由 pages/schedule/schedule.wxss 与 pages/duty/duty.wxss 通过 @import 引入
 * 类名与页面既有样式不冲突：表单标签用 cs-form-label
 * ============================================ */

.cs-form-label { font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 10rpx; }
.picker-value {
  height: 76rpx; display: flex; align-items: center; justify-content: space-between;
  padding: 0 30rpx; background: rgb(247,243,223); border: 4rpx solid var(--color-border-light);
  border-radius: 100rpx; color: var(--color-text); font-size: 28rpx;
  box-shadow: 0 5rpx 0 var(--color-shadow-input); box-sizing: border-box;
}
.picker-arrow { color: var(--color-primary); font-size: 36rpx; line-height: 1; }
.picker-sub { flex: 1; margin-left: 16rpx; font-size: 22rpx; color: var(--color-text-tertiary); text-align: right; }

.week-picker-card { padding-top: 26rpx; padding-bottom: 26rpx; }
.week-head { display: flex; align-items: center; justify-content: space-between; }
.week-badge {
  padding: 4rpx 20rpx; margin-bottom: 10rpx;
  border-radius: 100rpx; font-size: 23rpx; font-weight: 700;
  background: var(--color-bg-secondary); color: var(--color-text-secondary);
}
.week-badge-active { background: var(--color-primary-bg); color: var(--color-primary); }
.week-split { height: 2rpx; background: var(--color-split); margin: 28rpx 0 22rpx; }
.week-tip { margin-top: 12rpx; }
.week-action { width: 100%; margin-top: 24rpx; }

.day-list { padding-bottom: 12rpx; }
.day-card { padding-top: 26rpx; padding-bottom: 22rpx; }
.day-title-row { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 2rpx dashed var(--color-border-light); }
.day-title { font-size: 32rpx; font-weight: 700; color: var(--color-text); }
.day-card-today { box-shadow: 0 8rpx 20rpx rgba(107, 92, 67, 0.42), 0 0 0 4rpx var(--color-primary); }
.today-tag {
  margin-left: 16rpx; padding: 2rpx 18rpx;
  border-radius: 100rpx; background: var(--color-primary); color: #f8f8f0;
  font-size: 22rpx; font-weight: 700; vertical-align: middle;
}
.course-list { padding-top: 4rpx; }
.course-item { display: flex; align-items: flex-start; gap: 18rpx; padding: 22rpx 0 8rpx; }
.course-item + .course-item { border-top: 1rpx solid var(--color-split); }
.course-time { flex: 0 0 112rpx; color: var(--color-primary); font-size: 25rpx; font-weight: 700; padding-top: 2rpx; }
.course-copy { flex: 1; min-width: 0; }
.course-name { color: var(--color-text); font-size: 29rpx; font-weight: 700; line-height: 1.35; }
.course-detail, .course-weeks, .course-note { color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.5; margin-top: 4rpx; }
.course-weeks { color: var(--color-primary); }
/* 周次缺失/解析失败 —— 必须显眼，否则用户会把「待确认」当成正常值 */
.course-weeks-warn { color: var(--color-warning); font-weight: 700; }
.course-note { color: var(--color-warning); }
.course-arrow { color: var(--color-text-disabled); font-size: 40rpx; line-height: 1.2; }
.day-empty { padding: 24rpx 0 8rpx; color: var(--color-text-disabled); font-size: 26rpx; text-align: center; }
.empty-hint { margin-top: 12rpx; text-align: center; }

.manage-card {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 28rpx; font-weight: 600; color: var(--color-primary);
}
.manage-arrow { color: var(--color-text-disabled); font-size: 40rpx; line-height: 1; }
