.avatar-lg { width:120rpx;height:120rpx;border-radius:50%;margin-top:16rpx; }
.avatar-placeholder { background:var(--color-bg-secondary);display:flex;align-items:center;justify-content:center;font-size:56rpx;margin:16rpx auto 0; }
.profile-name { font-size:34rpx;font-weight:700; }
.section-title { font-size:28rpx;font-weight:600; }
.stat-item { font-size:24rpx;color:var(--color-text-muted); }
.stat-item.primary { color:var(--color-primary);font-weight:600; }

/* ===== 加载失败态 ===== */
.empty-icon { font-size: 72rpx; line-height: 1; }
.profile-error-msg {
  line-height: 1.6;
  word-break: break-all;
}

/* ===== 活动记录 · 按月折叠 ===== */
.month-fold-tip { margin-top: 8rpx; }

.month-group {
  margin-top: 16rpx;
  border: 1rpx solid var(--color-border-secondary);
  border-radius: var(--border-radius-base);
  overflow: hidden;
  background: var(--color-bg-secondary);
}

/* 标题行：整行可点，按压变色 */
.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 20rpx;
  transition: background var(--motion-fast) var(--motion-ease);
}
.month-head-hover { background: var(--color-primary-bg); }

.month-head-left { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.month-head-right { display: flex; align-items: center; gap: 14rpx; flex-shrink: 0; }

/* 箭头：折叠时指向右，展开时向下（rotate 90°） */
.month-arrow {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--color-primary);
  transform: rotate(0deg);
  transition: transform var(--motion-base) var(--motion-ease);
}
.month-arrow-open { transform: rotate(90deg); }

.month-label { font-size: 28rpx; font-weight: 600; color: var(--color-text); }
.month-summary { font-size: 22rpx; color: var(--color-text-secondary); }
.month-points { font-size: 26rpx; font-weight: 700; color: var(--color-primary); }

/* 明细区 */
.month-body {
  padding: 0 20rpx 8rpx;
  border-top: 1rpx dashed var(--color-border-light);
  background: var(--color-bg-content);
  animation: monthBodyIn var(--motion-base) var(--motion-ease);
}
@keyframes monthBodyIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid var(--color-split);
}
.record-row:last-child { border-bottom: none; }
.record-row-hover { background: var(--color-primary-bg); }

/* 可点击的任务条目：左侧内容缩短，右侧多一个箭头 */
.record-row-link .record-main { flex: 1; }
.record-arrow {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
  margin-left: -6rpx;
}

.record-main { min-width: 0; flex: 1; }
.record-title { font-size: 26rpx; color: var(--color-text-body); }
.record-title-clip { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.record-time { font-size: 22rpx; color: var(--color-text-secondary); margin-top: 4rpx; }

.record-points {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
}
/* 负分（旷会扣分 / 其它扣分）用红色；只作用于该行自身 */
.record-points-neg { color: var(--color-error); }
.record-row-neg .record-title { color: var(--color-error); }
