/* 任务大厅 — 复刻 Web 端 Ant Design */

/* 搜索栏 — 3D pill */
.search-bar { padding: var(--spacing-sm) var(--spacing-md); }
.search-bar .input {
  height: 80rpx; padding: 0 32rpx;
  background: var(--color-bg-content); border: 2rpx solid var(--color-border-light);
  border-radius: var(--border-radius-pill); font-size: var(--font-size-base);
  width: 100%; box-sizing: border-box;
  box-shadow: 0 6rpx 0 0 var(--color-shadow-input);
}
.search-bar .input:focus {
  border-color: var(--color-focus-yellow);
  box-shadow: 0 6rpx 0 0 var(--color-focus-yellow-dark), 0 0 0 6rpx rgba(255,204,0,0.15);
}

/* 成果档案入口 */
.archive-entry {
  display: flex; align-items: center; gap: 18rpx;
  margin: 4rpx var(--spacing-md) var(--spacing-sm); padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #ecfffb, #fffdf5);
  border: 1rpx solid #a7eadf; border-radius: var(--border-radius-lg);
  box-shadow: 0 5rpx 0 rgba(25, 200, 185, 0.12);
}
.archive-entry:active { background: #dff9f4; }
.archive-entry-icon {
  display: flex; align-items: center; justify-content: center;
  width: 64rpx; height: 64rpx; border-radius: 22rpx;
  background: var(--color-primary); color: #fff;
}
.archive-entry-copy { flex: 1; min-width: 0; }
.archive-entry-title { color: var(--color-text); font-size: var(--font-size-base); font-weight: 700; }
.archive-entry-desc { margin-top: 4rpx; color: var(--color-text-secondary); font-size: var(--font-size-xs); }
.archive-entry-arrow { color: var(--color-primary); font-size: 44rpx; line-height: 1; }

/* 筛选标签 */
.filter-scroll {
  white-space: nowrap;
  padding: 0 var(--spacing-md) var(--spacing-sm);
}
.filter-row { display: flex; gap: 8rpx; }
.filter-tag {
  display: inline-flex; align-items: center;
  height: 52rpx; padding: 0 20rpx;
  background: #fff; color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border); border-radius: 32rpx;
  font-size: var(--font-size-sm);
}
.filter-tag-active {
  background: var(--color-primary); color: #fff;
  border-color: var(--color-primary);
}

/* 任务卡片 */
.task-list { padding-bottom: 32rpx; }

.task-card {
  background: var(--color-bg-container);
  border: 1rpx solid var(--color-border-secondary);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-md);
  margin: var(--spacing-sm) var(--spacing-md);
}
.task-card:active { background: var(--color-fill-alter); }

.task-title {
  font-size: var(--font-size-lg); font-weight: 600;
  line-height: 1.3; flex: 1; min-width: 0;
}

.task-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.task-meta { gap: var(--spacing-sm); }

.task-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.task-footer {
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-split);
}

/* 发布按钮 */
.fab {
  position: fixed; right: 40rpx; bottom: 120rpx;
  width: 96rpx; height: 96rpx;
  background: var(--color-primary); color: #fff;
  border-radius: 50%; box-shadow: 0 6rpx 24rpx rgba(107,92,67,0.35);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 300;
  z-index: 10;
}
