/* settings — 动森主题 */

.form-page { padding: 0 0 80rpx; }

.card-title {
  font-size: var(--font-size-lg); font-weight: 600;
  margin-bottom: var(--spacing-md);
}

.form-label {
  font-size: 26rpx; color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.bg-preview {
  width: 100%; height: 160rpx;
  background-size: cover; background-position: center;
  border-radius: var(--border-radius-base); border: 1rpx solid var(--color-border);
}
.bg-preview-empty {
  background: var(--color-bg-layout);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--color-text-tertiary);
}

.start-page-picker {
  height: 80rpx; padding: 0 28rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: rgb(247, 243, 223);
  border: 5rpx solid var(--color-border-light);
  border-radius: 100rpx;
  box-shadow: 0 6rpx 0 var(--color-shadow-input);
  color: var(--color-text);
  box-sizing: border-box;
}
.start-page-arrow { color: var(--color-primary); font-size: 36rpx; }
